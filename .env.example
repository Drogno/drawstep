# Supabase Configuration
# Get these values from your Supabase project dashboard at https://supabase.com/dashboard

# Public URL - Safe to expose to the client
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anonymous/Public Key - Safe to expose to the client
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Service Role Key - NEVER expose to client, only use server-side
# Required for admin operations and bypassing RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Application Version - Used for client tracking and debugging
NEXT_PUBLIC_CLIENT_VERSION=1.0.0

# Optional: Supabase Local Development
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key